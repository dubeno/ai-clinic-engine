# LLM backend: "openai" or "anthropic"
LLM_BACKEND=anthropic

# Anthropic / compatible
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
ANTHROPIC_AUTH_TOKEN=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=mimo-v2-pro

# OpenAI / compatible (fallback)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Clinic profile
CLINIC_NAME=示例诊所
CLINIC_SPECIALTY=general
DEFAULT_DISCLAIMER=本文仅供参考，不构成医疗建议。如有健康问题，请咨询专业医生。

# SerpAPI (optional, for keyword research)
SERPAPI_KEY=

# WeChat (optional, for WeChat publishing)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Database
DB_PATH=clinic_engine.db

# Output
OUTPUT_DIR=./output
